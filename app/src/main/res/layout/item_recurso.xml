<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_bg"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Ícone do recurso -->
        <FrameLayout
            android:id="@+id/flItemRecursoIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_icon_resource">

            <ImageView
                android:id="@+id/ivItemRecursoIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_resource_box"
                android:contentDescription="Recurso" />
        </FrameLayout>

        <!-- Nome + detalhe -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/flItemRecursoIcon"
            android:layout_toStartOf="@id/llItemRecursoAcoes"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemRecursoNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="S3"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvItemRecursoDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="100.0 GB x 1.0 mês"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Custo + botões lápis/lixeira -->
        <LinearLayout
            android:id="@+id/llItemRecursoAcoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemRecursoCusto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 5,10"
                android:textColor="@color/status_healthy"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="end">

                <ImageButton
                    android:id="@+id/btnItemRecursoEditar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Editar recurso"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_edit_orange" />

                <ImageButton
                    android:id="@+id/btnItemRecursoExcluir"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="2dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Excluir recurso"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_delete_red" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
